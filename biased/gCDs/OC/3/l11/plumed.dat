# OPES metadynamics on the z-component of the COM-COM distance between the two CD rings
WHOLEMOLECULES ENTITY0=211-450 ENTITY1=451-690 #ACCOUNTS FOR PERIODIC BOUNDARY CONDITIONS
cd1: COM ATOMS=211-450  #CALCULATED COM OF EACH CD RING
cd2: COM ATOMS=451-690
d1: DISTANCE ATOMS=cd1,cd2 COMPONENTS  #WE ARE GOING TO BIAS THE Z DIRECTION OF THE DIATNCE BETWEEN THE COMS OF CD RINGS
uwall: UPPER_WALLS ARG=d1.z AT=3.0 KAPPA=10000.0 EXP=2 EPS=1 OFFSET=0
lwall: LOWER_WALLS ARG=d1.z AT=-0.5 KAPPA=1000.0 EXP=2 EPS=1 OFFSET=0
walls_bias: CUSTOM ARG=uwall.bias,lwall.bias FUNC=x+y PERIODIC=NO 
opes: OPES_METAD ARG=d1.z PACE=500 BARRIER=100 FILE=KERNELS TEMP=300 STATE_WFILE=STATE STATE_WSTRIDE=10000 STORE_STATES SIGMA=0.01
PRINT ARG=d1.z,opes.* FILE=COLVAR STRIDE=10
PRINT ARG=uwall.bias,lwall.bias,walls_bias FILE=WALLS STRIDE=10000
