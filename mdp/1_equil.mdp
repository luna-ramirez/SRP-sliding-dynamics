;; Equilibration

;; integrator and number of steps
integrator          =  md	    ; leap-frog integrator
dt		    =  0.002	    ; 2 fs
nsteps              =  1000000	    ; number of steps 2e-6 ns * 5e5 = 10e-1 ns = 1 ns  
periodic-molecules = yes

;; output control part (values indicate steps)                                                                          
nstxout             =  0 ; no coordenadas
nstxout-compressed  = 5000         ; 2e-6 ns * 1e4 = 2e-2 ns = 20 ps ;trayectoria comprimida            
nstvout             =  0             ;novelocidades                                                     
nstfout             =  0 ; no fuerzas
nstlog              =  5000 ; log
nstenergy           =  5000 ; energy

;; neighbor list
cutoff-scheme       =  Verlet       ;
nstlist             =  10	    ; step frequency for updating neighbour list

;; PBC and cutoff's
pbc                 =  xyz          ; PBC in all directions
rlist               =  1.0          ; recommended values for force field
coulombtype         =  PME          ; 
rcoulomb            =  1.0          ; recommended values for force field
vdwtype             =  Cut-off      ; 
rvdw                =  1.0          ; recommended values for force field

;; Constraints
constraint_algorithm= lincs         ; for constraining heavy atoms
constraints         = h-bonds

; Velocity generation
gen_vel             = yes
gen_temp            = 300
gen_seed            = -1

; Temperature coupling
tcoupl              = V-rescale
tc-grps             = System
tau_t               = 0.1           ; coupling constant in ps
ref_t               = 300           ; reference temperature

; Pressure coupling
pcoupl              = no            ; no pressure coupling

;energygrps          = PFO PLI SOL
DispCorr            = EnerPres